# StreetSense AI — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git
# NEVER put real values in this file — it is committed to git

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Mapbox ───────────────────────────────────────────────────
# Public token — safe to expose to browser
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Ordnance Survey Data Hub ──────────────────────────────────
# Register free at: https://osdatahub.os.uk
# In the OS Data Hub portal, create a project — it gives you:
#   "Project ID"     → OS_CLIENT_ID
#   "Project Secret" → OS_CLIENT_SECRET
# These are OAuth 2.0 client credentials (replaces the old single API key).
OS_CLIENT_ID=
OS_CLIENT_SECRET=
NEXT_PUBLIC_OS_API_KEY=          # Your Project ID — exposed to browser for Vector Tiles

# ── Street Manager (v7 API) ───────────────────────────────────
# IMPORTANT: The Street Manager JWT API is restricted to registered highway
# authorities and utility promoters — individual / open-source developers
# cannot obtain credentials from DfT.
#
# For open-source development (default): leave SM_EMAIL and SM_PASSWORD blank.
# StreetSense AI will use synthetic permit data (SM-008 seed) automatically.
# Real bulk permit data is also available at:
#   https://opendata.manage-roadworks.service.gov.uk  (public, no account needed)
#
# If you ARE a registered authority or promoter:
#   Auth endpoint: POST {SM_BASE_URL}/v3/party/authenticate
#   Header on all v7 requests: "token: {id_token}"  (NOT "Authorization: Bearer")
#   Sandbox: https://api.sandbox.manage-roadworks.service.gov.uk
#   Production: https://api.manage-roadworks.service.gov.uk
#
# SQS webhook delivery requires a separate DfT onboarding approval.
SM_EMAIL=                    # Leave blank for open-source / synthetic-data mode
SM_PASSWORD=                 # Leave blank for open-source / synthetic-data mode
SM_BASE_URL=https://api.sandbox.manage-roadworks.service.gov.uk

# SQS queue URL provided by DfT when your SNS subscription is approved
# Format: https://sqs.eu-west-2.amazonaws.com/{account_id}/{queue_name}
STREET_MANAGER_SQS_QUEUE_URL=

# ── Public API URL (webhook registration) ─────────────────────
# The publicly reachable base URL of this FastAPI server.
# Street Manager onboarding team registers these three derived endpoints:
#   Permit API:     {PUBLIC_API_URL}/webhooks/permits
#   Activity API:   {PUBLIC_API_URL}/webhooks/activities
#   Section 58 API: {PUBLIC_API_URL}/webhooks/section58
#
# Development:  ngrok tunnel  →  e.g. https://xxxx-xxxx.ngrok-free.app
# Production:   Hetzner domain → e.g. https://api.YOUR_DOMAIN
#
# Update this whenever the public address changes and notify the SM onboarding
# team so they can re-register the webhook endpoints.
PUBLIC_API_URL=http://localhost:8000

# ── AWS (for Street Manager SNS/SQS — SM-001) ────────────────
# IAM user needs: sqs:ReceiveMessage, sqs:DeleteMessage on the SM queue
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── NUAR ─────────────────────────────────────────────────────
# Apply at: https://www.nuar.uk
# Phase 4 only — leave blank until then
NUAR_API_KEY=
NUAR_BASE_URL=https://api.nuar.uk

# ── D-TRO (Phase 6) ──────────────────────────────────────────
# OAuth 2.0 client credentials (ADR-027) — POST /v1/oauth-generator
# Credentials come from the DfT D-TRO portal approval email
# Integration environment: https://dtro-integration.dft.gov.uk
# Production environment:  https://dtro.dft.gov.uk
# Leave blank to use synthetic D-TRO data (seed via /dtros/admin/seed or Admin Console)
DTRO_APP_ID=          # App ID from DfT D-TRO portal — used as clientId in OAuth2
DTRO_KEY=             # API key from DfT D-TRO portal — alternative clientId if no APP_ID
DTRO_SECRET=          # Client secret from DfT D-TRO portal
DTRO_BASE_URL=https://dtro-integration.dft.gov.uk

# ── Clerk (Phase 6 — Authority Portal DT-004) ─────────────────
# Create a Clerk application at: https://clerk.com
# Add /authority/* to the protected routes in the Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/authority/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/authority/dashboard

# ── Database ──────────────────────────────────────────────────
# Local: postgresql://postgres:postgres@localhost:5432/streetsense
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────
# Local: redis://localhost:6379
REDIS_URL=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# ── Admin console (development only — never commit real values) ──
# Set these in .env.local — never in this file
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_API_KEY=
