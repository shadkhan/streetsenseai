# StreetSense AI — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git
# NEVER put real values in this file — it is committed to git

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Mapbox ───────────────────────────────────────────────────
# Public token — safe to expose to browser
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Ordnance Survey Data Hub ──────────────────────────────────
# Register free at: https://osdatahub.os.uk
# One key covers NSG, Names, Open Roads, and Vector Tile APIs
OS_API_KEY=
NEXT_PUBLIC_OS_API_KEY=          # Same value — exposed to browser for Vector Tiles

# ── Street Manager (v7 API) ───────────────────────────────────
# Register at: https://api.manage-roadworks.service.gov.uk
STREET_MANAGER_API_KEY=
STREET_MANAGER_BASE_URL=https://api.sandbox.manage-roadworks.service.gov.uk

# SQS queue URL provided by DfT when your SNS subscription is approved
# Format: https://sqs.eu-west-2.amazonaws.com/{account_id}/{queue_name}
STREET_MANAGER_SQS_QUEUE_URL=

# ── AWS (for Street Manager SNS/SQS — SM-001) ────────────────
# IAM user needs: sqs:ReceiveMessage, sqs:DeleteMessage on the SM queue
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── NUAR ─────────────────────────────────────────────────────
# Apply at: https://www.nuar.uk
# Phase 4 only — leave blank until then
NUAR_API_KEY=
NUAR_BASE_URL=https://api.nuar.uk

# ── D-TRO ─────────────────────────────────────────────────────
# Phase 6 only — leave blank until then
DTRO_API_KEY=
DTRO_BASE_URL=https://dtro.dft.gov.uk/api

# ── Database ──────────────────────────────────────────────────
# Local: postgresql://postgres:postgres@localhost:5432/streetsense
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────
# Local: redis://localhost:6379
REDIS_URL=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development
