# StreetSense AI — Hetzner Production Environment Variables
# Copy to .env.prod and fill in real values.
# NEVER commit .env.prod — it is in .gitignore.

# ── Database (runs in Docker on the same CX23) ────────────────
DB_USER=streetsense
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=streetsense

# ── Street Manager JWT ────────────────────────────────────────
SM_EMAIL=shad.edims@gmail.com
SM_PASSWORD=CHANGE_ME
SM_BASE_URL=https://api.manage-roadworks.service.gov.uk

# ── Public API URL — update when domain is live ──────────────
# Used to build the three SM webhook endpoint URLs shown in /admin → System tab.
# After pointing DNS to this server, set to your real domain:
PUBLIC_API_URL=https://api.YOUR_DOMAIN
# Then notify SM onboarding team of the new webhook URLs:
#   Permits:    https://api.YOUR_DOMAIN/webhooks/permits
#   Activities: https://api.YOUR_DOMAIN/webhooks/activities
#   Section 58: https://api.YOUR_DOMAIN/webhooks/section58

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Mapbox ────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Ordnance Survey Data Hub ──────────────────────────────────
OS_CLIENT_ID=
OS_CLIENT_SECRET=
NEXT_PUBLIC_OS_API_KEY=

# ── NUAR (Phase 4) ────────────────────────────────────────────
NUAR_API_KEY=
NUAR_BASE_URL=https://api.nuar.uk

# ── AWS (SQS fallback) ────────────────────────────────────────
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STREET_MANAGER_SQS_QUEUE_URL=

# ── Admin console ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
ADMIN_API_KEY=CHANGE_ME_API_KEY

# ── Runtime ───────────────────────────────────────────────────
ENVIRONMENT=production
NODE_ENV=production
